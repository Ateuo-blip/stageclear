# Force LF line endings for source/config files
# Prevents Windows autocrlf from converting LF to CRLF,
# which previously broke Flyway checksums (CRLF drift on SQL files).

*.java        text eol=lf
*.sql         text eol=lf
*.xml         text eol=lf
*.properties  text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.md          text eol=lf
*.json        text eol=lf
*.gradle      text eol=lf
*.sh          text eol=lf

# Binary files - explicit
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.jar  binary
*.war  binary
